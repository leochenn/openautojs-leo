<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="#fafafa"
              android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_functions_keyboard" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:divider="@drawable/divider_functions_view"
        android:orientation="horizontal"
        android:showDividers="middle">

        <TextView
            android:id="@+id/captcha_key_1"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="1" />

        <TextView
            android:id="@+id/captcha_key_2"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="2" />

        <TextView
            android:id="@+id/captcha_key_3"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="3" />

        <TextView
            android:id="@+id/captcha_key_4"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="4" />

        <TextView
            android:id="@+id/captcha_key_5"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="5" />

        <TextView
            android:id="@+id/captcha_key_delete"
            style="@style/CaptchaNumberKeyboardDoneKey"
            android:text="@string/text_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_functions_keyboard" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:divider="@drawable/divider_functions_view"
        android:orientation="horizontal"
        android:showDividers="middle">

        <TextView
            android:id="@+id/captcha_key_6"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="6" />

        <TextView
            android:id="@+id/captcha_key_7"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="7" />

        <TextView
            android:id="@+id/captcha_key_8"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="8" />

        <TextView
            android:id="@+id/captcha_key_9"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="9" />

        <TextView
            android:id="@+id/captcha_key_0"
            style="@style/CaptchaNumberKeyboardKey"
            android:text="0" />

        <TextView
            android:id="@+id/captcha_key_done"
            style="@style/CaptchaNumberKeyboardDoneKey"
            android:text="@string/text_done" />
    </LinearLayout>
</LinearLayout>
